#!/usr/bin/env php
<?php
declare(strict_types=1);

// vendor/bin/flo. Projects normally run their root "flo" launcher instead,
// which boots the same kernel: php flo <command>

$autoloadCandidates = [
    // Composer's bin proxy tells us where the autoloader is (Composer 2.2+)
    $GLOBALS['_composer_autoload_path'] ?? null,
    // Installed as a dependency: <project>/vendor/hostkurd/flocms-cli/bin/flo
    __DIR__ . '/../../../autoload.php',
    // Developing flocms-cli itself
    __DIR__ . '/../vendor/autoload.php',
];

foreach (array_filter($autoloadCandidates) as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        // <project>/vendor/autoload.php -> <project>
        exit(FloCMS\CLI\Kernel::handle(dirname(realpath($autoload), 2), $argv));
    }
}

fwrite(STDERR, "FloCMS CLI: Composer's vendor/autoload.php not found. Run: composer install" . PHP_EOL);
exit(1);
