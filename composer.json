{
    "name": "hostkurd/flocms-cli",
    "description": "Command line interface for FloCMS",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "HostKurd"
        }
    ],
    "autoload": {
        "psr-4": {
            "FloCMS\\CLI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FloCMS\\CLI\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/flo"
    ],
    "require": {
        "php": "^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "source": "https://github.com/hostkurd/flocms-cli"
    },
    "scripts": {
        "test": "phpunit"
    }
}
