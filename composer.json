{
    "name": "hostkurd/flocms-cli",
    "description": "Command line interface for FloCMS: one command kernel for the framework, its packages and your application.",
    "type": "library",
    "license": "MIT",
    "keywords": ["flocms", "cli", "console", "framework", "generator", "migrations", "scheduler"],
    "homepage": "https://github.com/hostkurd/flocms-cli",
    "authors": [
        {
            "name": "HostKurd"
        }
    ],
    "support": {
        "issues": "https://github.com/hostkurd/flocms-cli/issues",
        "source": "https://github.com/hostkurd/flocms-cli",
        "docs": "https://github.com/hostkurd/flocms-cli#readme"
    },
    "require": {
        "php": "^8.1",
        "hostkurd/flocms-core": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "FloCMS\\CLI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FloCMS\\CLI\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/flo"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "2.0-dev"
        }
    }
}
