<?php
declare(strict_types=1);

namespace App\Api\Controllers;

use FloCMS\Api\Controller;
use FloCMS\Api\OpenApi\Summary;
use FloCMS\Api\OpenApi\Tag;
use FloCMS\Api\Validation\ValidatesRequests;
use FloCMS\Core\Http\Request;
use FloCMS\Core\Http\Response;

/**
 * Add to api/routes.php:
 *
 *     $router->group('/{{ route }}', static function (Router $router): void {
 *         $router->get('', [{{ class }}::class, 'index'])->name('index');
 *         $router->post('', [{{ class }}::class, 'store'])->name('store');
 *         $router->get('/{id:\d+}', [{{ class }}::class, 'show'])->name('show');
 *         $router->put('/{id:\d+}', [{{ class }}::class, 'update'])->name('update');
 *         $router->delete('/{id:\d+}', [{{ class }}::class, 'destroy'])->name('destroy');
 *     }, ['auth'], namePrefix: '{{ route }}.');
 */
#[Tag('{{ tag }}')]
final class {{ class }} extends Controller
{
    use ValidatesRequests;

    #[Summary('List {{ route }}')]
    public function index(Request $request): Response
    {
        return $this->success([]);
    }

    #[Summary('Create a {{ singular }}')]
    public function store(Request $request): Response
    {
        $data = $this->validate($request, [
            'name' => 'required|string|max:190',
        ]);

        return $this->created($data);
    }

    #[Summary('Show a {{ singular }}')]
    public function show(Request $request): Response
    {
        $id = $this->routeId($request);

        return $this->success(['id' => $id]);
    }

    #[Summary('Update a {{ singular }}')]
    public function update(Request $request): Response
    {
        $id = $this->routeId($request);
        $data = $this->validate($request, [
            'name' => 'sometimes|string|max:190',
        ]);

        return $this->success(['id' => $id] + $data);
    }

    #[Summary('Delete a {{ singular }}')]
    public function destroy(Request $request): Response
    {
        $this->routeId($request);

        return $this->noContent();
    }
}
